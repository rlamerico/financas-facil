# Finanças Fácil — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA commitar `.env*` com valores reais.

# --- Supabase (públicas: expostas ao browser, protegidas por RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only: NUNCA expor no client) ---
# Usada apenas em Route Handlers / server actions com privilégios elevados.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase MCP (apenas para Claude Code) ---
# Token de acesso para o MCP do Supabase.
# Gere em: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- n8n (server-only) ---
# Segredo compartilhado para validar o payload do webhook recebido do n8n.
N8N_WEBHOOK_SECRET=

# --- Planilha Google (server-only) ---
# Segredo compartilhado com o Apps Script da planilha "Finanças Familiares
# 2026" (scripts/apps-script/sheet-sync.gs). Gere um valor aleatório longo
# (ex.: `openssl rand -hex 32`) e configure o MESMO valor na Script Property
# WEBHOOK_SECRET do Apps Script.
SHEET_SYNC_SECRET=
